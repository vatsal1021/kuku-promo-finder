# Copy this file to .env and fill it in. .env is ignored by git.
# This is the only place the model is configured.

# gemini | openai | anthropic
LLM_PROVIDER=gemini

# Model name exactly as the provider calls it
LLM_MODEL=gemini-3.6-flash

# API key for the provider above
LLM_API_KEY=

# Optional: custom endpoint (openai and anthropic only), e.g. a company gateway
LLM_BASE_URL=

# Ranking weights: how much each score counts in the final rank score.
# Only the proportions matter (0.5 / 0.3 / 0.2 is the same as 5 / 3 / 2).
RANK_WEIGHT_HOOK=0.5
RANK_WEIGHT_CLIFFHANGER=0.3
RANK_WEIGHT_STANDALONE=0.2
